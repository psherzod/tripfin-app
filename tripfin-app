<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>USA Trip Finance</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,500;0,9..40,700;1,9..40,300&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0c0c10;
  --bg2: #14141a;
  --bg3: #1c1c26;
  --card: #18181f;
  --border: #252530;
  --accent: #00e5a0;
  --accent2: #ff4566;
  --gold: #ffc94a;
  --blue: #4da6ff;
  --text: #f0f0f8;
  --muted: #666680;
  --muted2: #44445a;
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

html, body {
  height: 100%; height: 100dvh;
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  overflow: hidden;
  user-select: none;
}

/* ─── SHELL ─── */
#app { display: flex; flex-direction: column; height: 100%; height: 100dvh; }

/* ─── HEADER ─── */
.header {
  padding: 14px 16px 10px;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.header-row { display: flex; justify-content: space-between; align-items: center; }
.app-name {
  font-family: 'Space Mono', monospace;
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 2px;
  text-transform: uppercase;
}
.trip-label { font-size: 10px; color: var(--muted); letter-spacing: 1px; margin-top: 1px; }
.person-pills { display: flex; gap: 5px; }
.person-pill {
  padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
  border: 1.5px solid var(--border); color: var(--muted); cursor: pointer;
  transition: all .18s;
}
.person-pill.active { border-color: var(--accent); color: var(--accent); background: rgba(0,229,160,.1); }

/* ─── SUMMARY CARDS ─── */
.summary {
  padding: 12px 14px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
  flex-shrink: 0;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
}
.sum-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 10px 8px;
  text-align: center;
}
.sum-card .label { font-size: 9px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
.sum-card .value {
  font-family: 'Space Mono', monospace;
  font-size: 15px; font-weight: 700;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.income-val { color: var(--accent); }
.expense-val { color: var(--accent2); }
.balance-pos { color: var(--gold); }
.balance-neg { color: var(--accent2); }

/* ─── NAV TABS ─── */
.nav {
  display: flex;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.nav-btn {
  flex: 1; padding: 9px 4px; background: none; border: none;
  font-size: 10px; font-weight: 700; color: var(--muted);
  cursor: pointer; letter-spacing: .5px; text-transform: uppercase;
  position: relative; font-family: 'DM Sans', sans-serif;
  transition: color .18s;
}
.nav-btn.active { color: var(--accent); }
.nav-btn.active::after {
  content: ''; position: absolute; bottom: 0; left: 20%; right: 20%;
  height: 2px; background: var(--accent); border-radius: 2px;
}
.nav-icon { font-size: 16px; display: block; margin-bottom: 2px; }

/* ─── PANELS ─── */
.panels { flex: 1; overflow: hidden; position: relative; }
.panel { position: absolute; inset: 0; overflow-y: auto; display: none; -webkit-overflow-scrolling: touch; }
.panel.active { display: block; }

/* ─── ADD FORM ─── */
.form-wrap { padding: 14px; }
.form-title {
  font-family: 'Space Mono', monospace;
  font-size: 12px; letter-spacing: 2px; color: var(--muted);
  text-transform: uppercase; margin-bottom: 14px;
}

/* Type toggle */
.type-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
.type-btn {
  padding: 12px; border-radius: 12px; border: 1.5px solid var(--border);
  background: var(--bg3); color: var(--muted); font-size: 13px; font-weight: 700;
  cursor: pointer; text-align: center; transition: all .2s;
  font-family: 'DM Sans', sans-serif;
}
.type-btn.active-income { border-color: var(--accent); color: var(--accent); background: rgba(0,229,160,.1); }
.type-btn.active-expense { border-color: var(--accent2); color: var(--accent2); background: rgba(255,69,102,.1); }

/* Amount input */
.amount-wrap {
  background: var(--bg3); border: 1.5px solid var(--border); border-radius: 14px;
  padding: 14px 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
  transition: border-color .2s;
}
.amount-wrap:focus-within { border-color: var(--accent); }
.currency-badge {
  font-family: 'Space Mono', monospace; font-size: 18px; font-weight: 700;
  color: var(--muted2); flex-shrink: 0;
}
.amount-input {
  flex: 1; background: none; border: none; outline: none;
  font-family: 'Space Mono', monospace; font-size: 28px; font-weight: 700;
  color: var(--text); width: 100%; min-width: 0;
}
.amount-input::placeholder { color: var(--muted2); }

/* Fields */
.field-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
.field {
  background: var(--bg3); border: 1.5px solid var(--border); border-radius: 12px;
  padding: 12px 14px; display: flex; align-items: center; gap: 10px;
  transition: border-color .2s;
}
.field:focus-within { border-color: var(--blue); }
.field-icon { font-size: 16px; flex-shrink: 0; }
.field input, .field select {
  flex: 1; background: none; border: none; outline: none;
  font-size: 14px; color: var(--text); font-family: 'DM Sans', sans-serif;
  font-weight: 500; min-width: 0; width: 100%;
}
.field select option { background: var(--bg3); color: var(--text); }
.field input::placeholder { color: var(--muted); }

/* Category grid */
.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 14px; }
.cat-btn {
  background: var(--bg3); border: 1.5px solid var(--border); border-radius: 10px;
  padding: 8px 4px; text-align: center; cursor: pointer; transition: all .18s;
  display: flex; flex-direction: column; align-items: center; gap: 3px;
}
.cat-btn.selected { border-color: var(--gold); background: rgba(255,201,74,.1); }
.cat-emoji { font-size: 18px; }
.cat-label { font-size: 9px; color: var(--muted); font-weight: 600; letter-spacing: .3px; }
.cat-btn.selected .cat-label { color: var(--gold); }

/* Submit btn */
.submit-btn {
  width: 100%; padding: 15px; border-radius: 14px; border: none;
  font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700;
  cursor: pointer; transition: all .2s; letter-spacing: .5px;
}
.submit-income { background: var(--accent); color: #000; }
.submit-expense { background: var(--accent2); color: #fff; }
.submit-btn:active { transform: scale(.97); }

/* ─── HISTORY ─── */
.hist-wrap { padding: 0 14px 80px; }
.hist-date-group { margin-top: 14px; }
.hist-date-label {
  font-size: 10px; font-weight: 700; color: var(--muted);
  letter-spacing: 2px; text-transform: uppercase;
  padding: 6px 0; border-bottom: 1px solid var(--border); margin-bottom: 6px;
}
.hist-item {
  display: flex; align-items: center; gap: 10px;
  background: var(--card); border: 1px solid var(--border);
  border-radius: 12px; padding: 11px 12px; margin-bottom: 6px;
  transition: all .18s; cursor: pointer; position: relative; overflow: hidden;
}
.hist-item::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  width: 3px; border-radius: 3px 0 0 3px;
}
.hist-item.income::before { background: var(--accent); }
.hist-item.expense::before { background: var(--accent2); }
.hist-emoji { font-size: 22px; flex-shrink: 0; }
.hist-info { flex: 1; min-width: 0; }
.hist-desc { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hist-meta { font-size: 11px; color: var(--muted); margin-top: 2px; }
.hist-amount {
  font-family: 'Space Mono', monospace; font-size: 14px; font-weight: 700;
  flex-shrink: 0;
}
.hist-amount.income { color: var(--accent); }
.hist-amount.expense { color: var(--accent2); }
.hist-delete {
  position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
  background: rgba(255,69,102,.2); border: none; border-radius: 8px;
  color: var(--accent2); font-size: 14px; padding: 4px 8px; cursor: pointer;
  display: none;
}
.hist-item.show-delete .hist-delete { display: block; }
.hist-item.show-delete .hist-amount { opacity: 0; }

.empty-state {
  text-align: center; padding: 50px 20px;
  color: var(--muted); font-size: 13px; line-height: 2;
}
.empty-icon { font-size: 40px; margin-bottom: 10px; }

/* ─── STATS PANEL ─── */
.stats-wrap { padding: 14px; }
.stats-section { margin-bottom: 18px; }
.stats-title {
  font-family: 'Space Mono', monospace; font-size: 10px; color: var(--muted);
  letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;
}
.stat-bar-item { margin-bottom: 8px; }
.stat-bar-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.stat-bar-label { font-size: 12px; font-weight: 600; }
.stat-bar-val { font-family: 'Space Mono', monospace; font-size: 11px; color: var(--muted); }
.stat-bar-track { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
.stat-bar-fill { height: 100%; border-radius: 3px; transition: width .5s cubic-bezier(.4,0,.2,1); }

/* City budget cards */
.city-budgets { display: flex; flex-direction: column; gap: 8px; }
.city-bud-card {
  background: var(--card); border: 1px solid var(--border); border-radius: 12px;
  padding: 12px 14px;
}
.city-bud-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.city-bud-name { font-size: 13px; font-weight: 700; }
.city-bud-spent { font-family: 'Space Mono', monospace; font-size: 12px; color: var(--accent2); }
.city-bud-bar { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
.city-bud-fill { height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--gold)); transition: width .5s; }

/* Person breakdown */
.person-breakdown { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.pb-card {
  background: var(--card); border: 1px solid var(--border); border-radius: 12px;
  padding: 12px; text-align: center;
}
.pb-name { font-size: 11px; color: var(--muted); margin-bottom: 4px; letter-spacing: .5px; }
.pb-amount { font-family: 'Space Mono', monospace; font-size: 16px; font-weight: 700; color: var(--accent2); }
.pb-income { font-size: 11px; color: var(--accent); margin-top: 2px; }

/* ─── BUDGET PANEL ─── */
.budget-wrap { padding: 14px 14px 80px; }
.budget-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.budget-title { font-family: 'Space Mono', monospace; font-size: 12px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }
.total-budget-card {
  background: linear-gradient(135deg, rgba(0,229,160,.12), rgba(77,166,255,.08));
  border: 1px solid rgba(0,229,160,.25);
  border-radius: 16px; padding: 18px; text-align: center; margin-bottom: 14px;
}
.tbc-label { font-size: 11px; color: rgba(0,229,160,.7); letter-spacing: 2px; text-transform: uppercase; }
.tbc-amount { font-family: 'Space Mono', monospace; font-size: 36px; font-weight: 700; color: var(--accent); margin: 6px 0; }
.tbc-sub { font-size: 11px; color: var(--muted); }
.budget-row {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--card); border: 1px solid var(--border); border-radius: 12px;
  padding: 12px 14px; margin-bottom: 8px;
}
.br-left { display: flex; align-items: center; gap: 10px; }
.br-emoji { font-size: 20px; }
.br-name { font-size: 13px; font-weight: 600; }
.br-sub { font-size: 10px; color: var(--muted); }
.br-amount { font-family: 'Space Mono', monospace; font-size: 13px; font-weight: 700; color: var(--gold); }

/* Toast */
.toast {
  position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%) translateY(20px);
  background: var(--bg3); border: 1px solid var(--border); border-radius: 24px;
  padding: 10px 20px; font-size: 13px; font-weight: 600; color: var(--text);
  z-index: 999; opacity: 0; transition: all .3s; pointer-events: none; white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* Scrollbar */
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
</style>
</head>
<body>
<div id="app">

  <!-- HEADER -->
  <div class="header">
    <div class="header-row">
      <div>
        <div class="app-name">💸 USA FINANCE</div>
        <div class="trip-label">13 ИЮНЯ — 5 ИЮЛЯ · ТРЕКЕР РАСХОДОВ</div>
      </div>
      <div class="person-pills" id="personPills"></div>
    </div>
  </div>

  <!-- SUMMARY -->
  <div class="summary">
    <div class="sum-card">
      <div class="label">📥 Приход</div>
      <div class="value income-val" id="totalIncome">$0</div>
    </div>
    <div class="sum-card">
      <div class="label">📤 Расход</div>
      <div class="value expense-val" id="totalExpense">$0</div>
    </div>
    <div class="sum-card">
      <div class="label">💰 Остаток</div>
      <div class="value balance-pos" id="balance">$0</div>
    </div>
  </div>

  <!-- NAV -->
  <div class="nav">
    <button class="nav-btn active" onclick="switchPanel('add')">
      <span class="nav-icon">➕</span>ДОБАВИТЬ
    </button>
    <button class="nav-btn" onclick="switchPanel('history')">
      <span class="nav-icon">📋</span>ИСТОРИЯ
    </button>
    <button class="nav-btn" onclick="switchPanel('stats')">
      <span class="nav-icon">📊</span>АНАЛИЗ
    </button>
    <button class="nav-btn" onclick="switchPanel('budget')">
      <span class="nav-icon">🗓</span>ПЛАН
    </button>
  </div>

  <!-- PANELS -->
  <div class="panels">

    <!-- ADD PANEL -->
    <div class="panel active" id="panel-add">
      <div class="form-wrap">
        <div class="form-title">Новая запись</div>

        <!-- Type -->
        <div class="type-toggle">
          <div class="type-btn active-expense" id="btn-expense" onclick="setType('expense')">
            📤 Расход
          </div>
          <div class="type-btn" id="btn-income" onclick="setType('income')">
            📥 Приход
          </div>
        </div>

        <!-- Amount -->
        <div class="amount-wrap">
          <div class="currency-badge">$</div>
          <input class="amount-input" id="amountInput" type="number" inputmode="decimal" placeholder="0.00" step="0.01" min="0">
        </div>

        <!-- Fields -->
        <div class="field-group">
          <div class="field">
            <span class="field-icon">📝</span>
            <input id="descInput" type="text" placeholder="Описание (напр. обед в McDonald's)">
          </div>
          <div class="field">
            <span class="field-icon">🏙</span>
            <select id="citySelect">
              <option value="">Выберите город</option>
              <option>🗽 Нью-Йорк</option>
              <option>🌉 Сан-Франциско</option>
              <option>🌴 Лос-Анджелес</option>
              <option>🎰 Лас-Вегас</option>
              <option>🏜️ Гранд-Каньон</option>
              <option>⚽ Хьюстон</option>
              <option>🌊 Майами</option>
              <option>🎢 Орландо</option>
              <option>🌿 Саванна</option>
              <option>🌸 Чарльстон</option>
              <option>🏛️ Вашингтон D.C.</option>
              <option>✈️ В дороге</option>
            </select>
          </div>
          <div class="field">
            <span class="field-icon">👤</span>
            <select id="personSelect">
              <option value="all">Общий / Все</option>
            </select>
          </div>
        </div>

        <!-- Categories -->
        <div class="cat-grid" id="catGrid"></div>

        <!-- Submit -->
        <button class="submit-btn submit-expense" id="submitBtn" onclick="addEntry()">
          Добавить расход
        </button>
      </div>
    </div>

    <!-- HISTORY PANEL -->
    <div class="panel" id="panel-history">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 14px 0">
        <div style="font-family:'Space Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase">История</div>
        <button onclick="clearAll()" style="background:none;border:none;color:var(--muted);font-size:11px;cursor:pointer;font-family:'DM Sans',sans-serif">Очистить всё</button>
      </div>
      <div class="hist-wrap" id="histList"></div>
    </div>

    <!-- STATS PANEL -->
    <div class="panel" id="panel-stats">
      <div class="stats-wrap">
        <div class="stats-section">
          <div class="stats-title">Расходы по категориям</div>
          <div id="catStats"></div>
        </div>
        <div class="stats-section">
          <div class="stats-title">По городам</div>
          <div class="city-budgets" id="cityStats"></div>
        </div>
        <div class="stats-section">
          <div class="stats-title">По участникам</div>
          <div class="person-breakdown" id="personStats"></div>
        </div>
      </div>
    </div>

    <!-- BUDGET PLAN PANEL -->
    <div class="panel" id="panel-budget">
      <div class="budget-wrap">
        <div class="total-budget-card">
          <div class="tbc-label">Бюджет поездки</div>
          <div class="tbc-amount" id="budgetRemaining">$5,000</div>
          <div class="tbc-sub" id="budgetSubtext">Введите бюджет и отслеживайте</div>
        </div>

        <!-- Budget input -->
        <div class="field" style="margin-bottom:14px;">
          <span class="field-icon">💵</span>
          <input id="budgetInput" type="number" inputmode="decimal" placeholder="Введите ваш общий бюджет ($)" style="font-size:15px;font-weight:700;">
          <button onclick="setBudget()" style="background:var(--accent);border:none;border-radius:8px;padding:6px 12px;color:#000;font-weight:700;font-size:12px;cursor:pointer;flex-shrink:0;">SET</button>
        </div>

        <div style="font-family:'Space Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;">Плановый бюджет по статьям</div>

        <div class="budget-row"><div class="br-left"><span class="br-emoji">✈️</span><div><div class="br-name">Авиабилеты</div><div class="br-sub">Все перелёты</div></div></div><div class="br-amount">$940–1510</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">🚗</span><div><div class="br-name">Транспорт</div><div class="br-sub">Аренда + бензин</div></div></div><div class="br-amount">$870–1220</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">🏨</span><div><div class="br-name">Жильё</div><div class="br-sub">21 ночь</div></div></div><div class="br-amount">$810–1360</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">🍔</span><div><div class="br-name">Еда</div><div class="br-sub">22 дня</div></div></div><div class="br-amount">$946–1474</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">🎟️</span><div><div class="br-name">Аттракции</div><div class="br-sub">Достопримечательности</div></div></div><div class="br-amount">$632–832</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">⚽</span><div><div class="br-name">Матч</div><div class="br-sub">Узбекистан–Португалия</div></div></div><div class="br-amount">$100–300</div></div>
        <div class="budget-row"><div class="br-left"><span class="br-emoji">🍸</span><div><div class="br-name">Ночная жизнь</div><div class="br-sub">Бары, клубы</div></div></div><div class="br-amount">$350–600</div></div>
      </div>
    </div>

  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
// ─────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────
const STORAGE_KEY = 'usaTripFinance_v2';

let state = {
  entries: [],
  persons: ['Шерзод', 'Музаффар', 'Анвар'],
  activePerson: 'all',
  budget: 5000,
  currentType: 'expense',
  selectedCat: '🍔',
};

function loadState() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      state = { ...state, ...parsed };
    }
  } catch(e) {}
}

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify({
      entries: state.entries,
      persons: state.persons,
      budget: state.budget,
    }));
  } catch(e) {}
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────
const CATEGORIES = [
  { emoji: '🍔', label: 'Еда' },
  { emoji: '🚗', label: 'Транспорт' },
  { emoji: '🏨', label: 'Жильё' },
  { emoji: '🎟️', label: 'Аттракции' },
  { emoji: '🛍️', label: 'Шоппинг' },
  { emoji: '🍸', label: 'Бары' },
  { emoji: '⚽', label: 'Матч' },
  { emoji: '💊', label: 'Прочее' },
];

const INCOME_CATEGORIES = [
  { emoji: '💵', label: 'Наличные' },
  { emoji: '💳', label: 'Карта' },
  { emoji: '🔄', label: 'Обмен' },
  { emoji: '👥', label: 'От друга' },
  { emoji: '🏦', label: 'Банк' },
  { emoji: '📱', label: 'Перевод' },
  { emoji: '🎁', label: 'Бонус' },
  { emoji: '💰', label: 'Другое' },
];

function renderCategories() {
  const grid = document.getElementById('catGrid');
  const cats = state.currentType === 'expense' ? CATEGORIES : INCOME_CATEGORIES;
  grid.innerHTML = cats.map(c => `
    <div class="cat-btn ${state.selectedCat === c.emoji ? 'selected' : ''}" onclick="selectCat('${c.emoji}')">
      <div class="cat-emoji">${c.emoji}</div>
      <div class="cat-label">${c.label}</div>
    </div>
  `).join('');
}

function selectCat(emoji) {
  state.selectedCat = emoji;
  renderCategories();
}

// ─────────────────────────────────────────────
// TYPE TOGGLE
// ─────────────────────────────────────────────
function setType(type) {
  state.currentType = type;
  state.selectedCat = type === 'expense' ? '🍔' : '💵';

  const be = document.getElementById('btn-expense');
  const bi = document.getElementById('btn-income');
  const sb = document.getElementById('submitBtn');

  be.className = 'type-btn' + (type === 'expense' ? ' active-expense' : '');
  bi.className = 'type-btn' + (type === 'income' ? ' active-income' : '');

  sb.className = 'submit-btn ' + (type === 'expense' ? 'submit-expense' : 'submit-income');
  sb.textContent = type === 'expense' ? 'Добавить расход' : 'Добавить приход';

  renderCategories();
}

// ─────────────────────────────────────────────
// PERSONS
// ─────────────────────────────────────────────
function renderPersonPills() {
  const container = document.getElementById('personPills');
  const items = [{ id: 'all', label: 'Все' }, ...state.persons.map(p => ({ id: p, label: p }))];
  container.innerHTML = items.map(p => `
    <div class="person-pill ${state.activePerson === p.id ? 'active' : ''}"
         onclick="setActivePerson('${p.id}')">${p.label}</div>
  `).join('');

  // Person select in form
  const sel = document.getElementById('personSelect');
  sel.innerHTML = '<option value="all">Общий / Все</option>' +
    state.persons.map(p => `<option value="${p}">${p}</option>`).join('');
}

function setActivePerson(id) {
  state.activePerson = id;
  renderPersonPills();
  updateSummary();
  renderHistory();
  renderStats();
}

// ─────────────────────────────────────────────
// FILTERED ENTRIES
// ─────────────────────────────────────────────
function filteredEntries() {
  if (state.activePerson === 'all') return state.entries;
  return state.entries.filter(e => e.person === state.activePerson || e.person === 'all');
}

// ─────────────────────────────────────────────
// SUMMARY
// ─────────────────────────────────────────────
function updateSummary() {
  const entries = filteredEntries();
  const income = entries.filter(e => e.type === 'income').reduce((s, e) => s + e.amount, 0);
  const expense = entries.filter(e => e.type === 'expense').reduce((s, e) => s + e.amount, 0);
  const bal = income - expense;

  document.getElementById('totalIncome').textContent = '$' + income.toFixed(0);
  document.getElementById('totalExpense').textContent = '$' + expense.toFixed(0);
  const balEl = document.getElementById('balance');
  balEl.textContent = (bal >= 0 ? '+$' : '-$') + Math.abs(bal).toFixed(0);
  balEl.className = 'value ' + (bal >= 0 ? 'balance-pos' : 'balance-neg');
}

// ─────────────────────────────────────────────
// ADD ENTRY
// ─────────────────────────────────────────────
function addEntry() {
  const amount = parseFloat(document.getElementById('amountInput').value);
  if (!amount || amount <= 0) { showToast('⚠️ Введите сумму!'); return; }

  const desc = document.getElementById('descInput').value.trim() || (state.currentType === 'expense' ? 'Расход' : 'Приход');
  const city = document.getElementById('citySelect').value || '✈️ В дороге';
  const person = document.getElementById('personSelect').value;

  const entry = {
    id: Date.now(),
    type: state.currentType,
    amount,
    desc,
    city,
    person,
    cat: state.selectedCat,
    date: new Date().toLocaleDateString('ru-RU', { day:'numeric', month:'short' }),
    time: new Date().toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' }),
    ts: Date.now(),
  };

  state.entries.unshift(entry);
  saveState();
  updateSummary();
  renderHistory();
  renderStats();

  // Reset form
  document.getElementById('amountInput').value = '';
  document.getElementById('descInput').value = '';

  showToast(state.currentType === 'expense' ? `✅ Расход $${amount.toFixed(2)} добавлен` : `✅ Приход $${amount.toFixed(2)} добавлен`);

  // Haptic
  try { window.Telegram?.WebApp?.HapticFeedback?.impactOccurred('medium'); } catch(e) {}
}

// ─────────────────────────────────────────────
// HISTORY
// ─────────────────────────────────────────────
function renderHistory() {
  const container = document.getElementById('histList');
  const entries = filteredEntries();

  if (entries.length === 0) {
    container.innerHTML = `<div class="empty-state">
      <div class="empty-icon">💸</div>
      Пока нет записей.<br>Добавьте первую транзакцию!
    </div>`;
    return;
  }

  // Group by date
  const groups = {};
  entries.forEach(e => {
    if (!groups[e.date]) groups[e.date] = [];
    groups[e.date].push(e);
  });

  container.innerHTML = Object.entries(groups).map(([date, items]) => `
    <div class="hist-date-group">
      <div class="hist-date-label">${date}</div>
      ${items.map(e => `
        <div class="hist-item ${e.type}" id="hi-${e.id}" onclick="toggleDelete(${e.id})">
          <div class="hist-emoji">${e.cat}</div>
          <div class="hist-info">
            <div class="hist-desc">${e.desc}</div>
            <div class="hist-meta">${e.city} · ${e.person === 'all' ? 'Все' : e.person} · ${e.time}</div>
          </div>
          <div class="hist-amount ${e.type}">${e.type === 'income' ? '+' : '-'}$${e.amount.toFixed(2)}</div>
          <button class="hist-delete" onclick="deleteEntry(event, ${e.id})">🗑</button>
        </div>
      `).join('')}
    </div>
  `).join('');
}

let activeDeleteId = null;
function toggleDelete(id) {
  if (activeDeleteId && activeDeleteId !== id) {
    document.getElementById('hi-' + activeDeleteId)?.classList.remove('show-delete');
  }
  const el = document.getElementById('hi-' + id);
  el?.classList.toggle('show-delete');
  activeDeleteId = el?.classList.contains('show-delete') ? id : null;
}

function deleteEntry(e, id) {
  e.stopPropagation();
  state.entries = state.entries.filter(en => en.id !== id);
  saveState();
  updateSummary();
  renderHistory();
  renderStats();
  showToast('🗑 Запись удалена');
}

function clearAll() {
  if (!confirm('Удалить все записи?')) return;
  state.entries = [];
  saveState();
  updateSummary();
  renderHistory();
  renderStats();
  showToast('🗑 Все записи удалены');
}

// ─────────────────────────────────────────────
// STATS
// ─────────────────────────────────────────────
function renderStats() {
  const entries = filteredEntries();
  const expenses = entries.filter(e => e.type === 'expense');
  const totalExp = expenses.reduce((s, e) => s + e.amount, 0);

  // By category
  const catMap = {};
  expenses.forEach(e => { catMap[e.cat] = (catMap[e.cat] || 0) + e.amount; });
  const catSorted = Object.entries(catMap).sort((a, b) => b[1] - a[1]);
  const maxCat = catSorted[0]?.[1] || 1;

  const catLabel = { '🍔':'Еда','🚗':'Транспорт','🏨':'Жильё','🎟️':'Аттракции','🛍️':'Шоппинг','🍸':'Бары','⚽':'Матч','💊':'Прочее','💵':'Наличные','💳':'Карта','🔄':'Обмен','👥':'От друга','🏦':'Банк','📱':'Перевод','🎁':'Бонус','💰':'Другое' };

  const colors = ['#00e5a0','#4da6ff','#ffc94a','#ff4566','#b47cff','#ff9f40','#06d6a0','#ef233c'];

  document.getElementById('catStats').innerHTML = catSorted.length === 0
    ? '<div style="color:var(--muted);font-size:12px;text-align:center;padding:20px 0">Нет данных</div>'
    : catSorted.map(([emoji, amt], i) => `
      <div class="stat-bar-item">
        <div class="stat-bar-top">
          <div class="stat-bar-label">${emoji} ${catLabel[emoji] || emoji}</div>
          <div class="stat-bar-val">$${amt.toFixed(0)} · ${totalExp > 0 ? Math.round(amt/totalExp*100) : 0}%</div>
        </div>
        <div class="stat-bar-track">
          <div class="stat-bar-fill" style="width:${(amt/maxCat)*100}%;background:${colors[i%colors.length]}"></div>
        </div>
      </div>
    `).join('');

  // By city
  const cityMap = {};
  expenses.forEach(e => { if(e.city) cityMap[e.city] = (cityMap[e.city] || 0) + e.amount; });
  const citySorted = Object.entries(cityMap).sort((a, b) => b[1] - a[1]);
  const maxCity = citySorted[0]?.[1] || 1;

  document.getElementById('cityStats').innerHTML = citySorted.length === 0
    ? '<div style="color:var(--muted);font-size:12px;text-align:center;padding:10px 0">Нет данных</div>'
    : citySorted.map(([city, amt]) => `
      <div class="city-bud-card">
        <div class="city-bud-top">
          <div class="city-bud-name">${city}</div>
          <div class="city-bud-spent">$${amt.toFixed(0)}</div>
        </div>
        <div class="city-bud-bar">
          <div class="city-bud-fill" style="width:${(amt/maxCity)*100}%"></div>
        </div>
      </div>
    `).join('');

  // By person
  const personMap = {};
  const incomeByPerson = {};
  state.persons.forEach(p => { personMap[p] = 0; incomeByPerson[p] = 0; });
  entries.forEach(e => {
    if (e.person !== 'all') {
      if (e.type === 'expense') personMap[e.person] = (personMap[e.person] || 0) + e.amount;
      else incomeByPerson[e.person] = (incomeByPerson[e.person] || 0) + e.amount;
    }
  });

  document.getElementById('personStats').innerHTML = state.persons.map(p => `
    <div class="pb-card">
      <div class="pb-name">${p}</div>
      <div class="pb-amount">-$${(personMap[p]||0).toFixed(0)}</div>
      <div class="pb-income">+$${(incomeByPerson[p]||0).toFixed(0)}</div>
    </div>
  `).join('');
}

// ─────────────────────────────────────────────
// BUDGET
// ─────────────────────────────────────────────
function setBudget() {
  const val = parseFloat(document.getElementById('budgetInput').value);
  if (!val || val <= 0) { showToast('⚠️ Введите бюджет'); return; }
  state.budget = val;
  saveState();
  updateBudgetDisplay();
  showToast(`✅ Бюджет $${val.toFixed(0)} установлен`);
}

function updateBudgetDisplay() {
  const expenses = state.entries.filter(e => e.type === 'expense').reduce((s, e) => s + e.amount, 0);
  const remaining = state.budget - expenses;
  const pct = Math.min(expenses / state.budget * 100, 100);
  const el = document.getElementById('budgetRemaining');
  const sub = document.getElementById('budgetSubtext');
  el.textContent = (remaining >= 0 ? '$' : '-$') + Math.abs(remaining).toFixed(0);
  el.style.color = remaining >= 0 ? 'var(--accent)' : 'var(--accent2)';
  sub.textContent = `Потрачено $${expenses.toFixed(0)} из $${state.budget.toFixed(0)} (${pct.toFixed(0)}%)`;
}

// ─────────────────────────────────────────────
// PANEL SWITCHING
// ─────────────────────────────────────────────
function switchPanel(name) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  event.currentTarget.classList.add('active');
  if (name === 'stats') renderStats();
  if (name === 'budget') updateBudgetDisplay();
  if (name === 'history') renderHistory();
}

// ─────────────────────────────────────────────
// TOAST
// ─────────────────────────────────────────────
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

// ─────────────────────────────────────────────
// TELEGRAM INIT
// ─────────────────────────────────────────────
function initTelegram() {
  try {
    const tg = window.Telegram?.WebApp;
    if (tg) {
      tg.ready();
      tg.expand();
      if (tg.colorScheme === 'light') {
        document.documentElement.style.setProperty('--bg', '#f5f5f8');
        document.documentElement.style.setProperty('--bg2', '#ffffff');
        document.documentElement.style.setProperty('--bg3', '#f0f0f5');
        document.documentElement.style.setProperty('--card', '#ffffff');
        document.documentElement.style.setProperty('--text', '#111118');
        document.documentElement.style.setProperty('--muted', '#888899');
        document.documentElement.style.setProperty('--border', '#e0e0e8');
      }
      // Save persons from Telegram if available
      const user = tg.initDataUnsafe?.user;
      if (user?.first_name && !state.persons.includes(user.first_name)) {
        state.persons[0] = user.first_name;
      }
    }
  } catch(e) {}
}

// ─────────────────────────────────────────────
// INIT
// ─────────────────────────────────────────────
loadState();
initTelegram();
renderPersonPills();
renderCategories();
updateSummary();
renderHistory();
updateBudgetDisplay();
</script>
</body>
</html>
